# Copie este arquivo para ".env" e ajuste. O .env NUNCA vai para o GitHub (está no .gitignore).

# Endereço que o cliente usa para abrir propostas e contratos.
# Teste só no PC:            http://localhost:8080
# Teste com o celular (Wi-Fi): http://IP-DO-SEU-PC:8080   (ex.: http://192.168.0.15:8080)
# Produção:                  https://crm.deltasolar.com.br
PUBLIC_URL=http://localhost:8080

# Quem entra no CRM: email:senha, separados por vírgula. Use #vendedor no fim para perfil de vendedor (sem sufixo = gestor).
# Ex.: gestor@deltasolar.com.br:senha1,vendedor@deltasolar.com.br:senha2#vendedor
CRM_USUARIOS=yuri@deltasolar.com.br:troque-esta-senha,equipe@deltasolar.com.br:outra-senha

# Senha do banco (troque em produção)
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# E-mail. No teste local o Mailpit captura tudo (veja em http://localhost:8025) e nada sai de verdade.
# Em produção: SMTP do seu provedor (Locaweb, Hostinger, Gmail com senha de app, Resend, Brevo...).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Delta Solar <contato@deltasolar.com.br>

# Tarifa automática: CSV de tarifas das distribuidoras (dados abertos da ANEEL). Deixe vazio para usar só o valor manual.
TARIFA_CSV_URL=
