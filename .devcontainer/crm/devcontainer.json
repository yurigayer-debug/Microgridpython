{
  "name": "Delta CRM (Docker)",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postStartCommand": "bash .devcontainer/crm/start.sh",
  "forwardPorts": [8080, 8025],
  "portsAttributes": {
    "8080": { "label": "Delta CRM", "onAutoForward": "openBrowser" },
    "8025": { "label": "E-mails de teste (Mailpit)", "onAutoForward": "silent" }
  },
  "customizations": { "codespaces": { "openFiles": ["crm/LEIAME-docker.md"] } }
}
